PORT=5000
MONGODB_URI=your_mongodb_connection_string
JWT_SECRET=your_secret_here
JWT_EXPIRES_IN=20d
COOKIE_NAME=token
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_MEDIA_FOLDER=cryoverse/resources
GROQ_API_KEY=your_groq_api_key
GROQ_TEXT_MODEL=groq_text_model_name
GROQ_STT_MODEL=groq_stt_model_name
# Bluesky publishing (admin-only outbound posts)
# BLUESKY_HANDLE     - the institutional Bluesky handle that publishes posts, e.g. your-institutional-handle.bsky.social
# BLUESKY_APP_PASSWORD - a dedicated app password created under Settings > App Passwords (never the account password)
# BLUESKY_SERVICE    - the PDS endpoint the app password authenticates against
# The former X (Twitter) publishing variables (X_API_KEY, X_API_SECRET, X_ACCESS_TOKEN,
# X_ACCESS_TOKEN_SECRET, X_OAUTH_REQUEST_TOKEN, X_OAUTH_REQUEST_TOKEN_SECRET) are no
# longer read and should be removed from any deployed .env file.
BLUESKY_HANDLE=your-institutional-handle.bsky.social
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
BLUESKY_SERVICE=https://bsky.social